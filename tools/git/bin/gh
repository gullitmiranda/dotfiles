#!/usr/bin/env bash

# gh wrapper — routes GitHub CLI calls to the correct account by injecting a
# fresh keyring token for the resolved user.
#
# Routing precedence (first match wins):
#   1. GH_TOKEN/GITHUB_TOKEN already set → pass through (CI, mise, manual)
#   2. `gh auth ...` subcommands → pass through (keeps `gh auth status` truthful)
#   3. Non-github.com host (--hostname, GHE) → pass through
#   4. Explicit owner in args (-R owner/repo, --repo, GitHub URLs) → owners table
#   5. cwd inside a known gitdir → paths table
#   6. No match → pass through (active keyring account)
#
# Routing tables are read directly from the dotfiles config.yaml
# (variables.git.accounts[].gh_user / owners / gitdirs) via yq on every call —
# no generated files, changes take effect immediately.
#
# Overrides:
#   GH_ROUTER_CONFIG — path to an alternative config.yaml
#   GH_REAL_BIN      — path to the real gh binary

set -euo pipefail

### Locate config.yaml

resolve_config() {
	if [[ -n ${GH_ROUTER_CONFIG:-} ]]; then
		[[ -f ${GH_ROUTER_CONFIG} ]] && echo "${GH_ROUTER_CONFIG}"
		return 0
	fi
	# Self-locate: this script lives at <dotfiles>/tools/git/bin/gh (possibly
	# via a symlink from ~/.local/bin/gh). Worktrees don't have config.yaml
	# (git-ignored), so fall back to the conventional dotfiles locations.
	local src="$0" dir candidate
	[[ -L ${src} ]] && src="$(readlink "${src}")"
	dir="$(cd "$(dirname "${src}")" && pwd)"
	for candidate in \
		"${dir}/../../../config.yaml" \
		"${HOME}/code/gullit/dotfiles/config.yaml" \
		"${HOME}/.dotfiles/config.yaml"; do
		if [[ -f ${candidate} ]]; then
			echo "${candidate}"
			return 0
		fi
	done
	return 0
}

### Resolve the real gh binary (avoid recursing into this wrapper)

resolve_real_gh() {
	local self candidate resolved dir
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
	if [[ -n ${GH_REAL_BIN:-} && -x ${GH_REAL_BIN} ]]; then
		echo "${GH_REAL_BIN}"
		return 0
	fi
	# Walk PATH entries in order, skip this wrapper
	local IFS=:
	for dir in ${PATH}; do
		candidate="${dir}/gh"
		if [[ -x ${candidate} ]]; then
			resolved="$(cd "${dir}" 2>/dev/null && pwd)/gh" || continue
			if [[ ${resolved} != "${self}" ]]; then
				echo "${candidate}"
				return 0
			fi
		fi
	done
	echo "gh wrapper: real gh binary not found in PATH" >&2
	exit 127
}

### Routing lookups (yq on config.yaml)

user_for_owner() {
	# Prints the gh_user whose account lists the given owner, or empty string
	local owner="$1"
	[[ -n ${CONFIG_YAML} ]] || return 0
	o="${owner}" yq -r '
		.variables.git.accounts[]? | select(.owners[]? == env(o)) | .gh_user
	' "${CONFIG_YAML}" 2>/dev/null | head -1 || true
}

user_for_path() {
	# Prints the gh_user whose gitdirs contain the cwd (longest prefix wins)
	local cwd="$1"
	[[ -n ${CONFIG_YAML} ]] || return 0
	# shellcheck disable=SC2016 # $u/$d/ENV are yq variables, not shell
	cwd="${cwd}" home="${HOME}" yq -r '
		[ .variables.git.accounts[]? |
		  .gh_user as $u |
		  (.gitdirs[]? | sub("^~"; env(home)) | sub("/$"; "")) as $d |
		  select(env(cwd) == $d or (env(cwd) | test("^" + $d + "/"))) |
		  [$u, ($d | length)] ]
		| sort_by(.[1]) | .[-1][0] // ""
	' "${CONFIG_YAML}" 2>/dev/null || true
}

owner_from_args() {
	# Extract owner from -R/--repo flags or GitHub URLs in args
	local prev="" arg rest
	for arg in "$@"; do
		case "${prev}" in
		-R | --repo)
			echo "${arg%%/*}"
			return 0
			;;
		*) ;;
		esac
		case "${arg}" in
		-R*/*)
			echo "${arg#-R}" | cut -d/ -f1
			return 0
			;;
		--repo=*/*)
			echo "${arg#--repo=}" | cut -d/ -f1
			return 0
			;;
		*github.com/*)
			rest="${arg#*github.com/}"
			echo "${rest}" | cut -d/ -f1 | cut -d: -f2
			return 0
			;;
		*/*)
			# owner/repo positional arg (e.g. gh repo clone some-org/repo)
			echo "${arg}" | cut -d/ -f1
			return 0
			;;
		*) ;;
		esac
		prev="${arg}"
	done
	return 0
}

### Main

real_gh="$(resolve_real_gh)"

# 1. Respect an explicitly provided token
if [[ -n ${GH_TOKEN:-} || -n ${GITHUB_TOKEN:-} ]]; then
	exec "${real_gh}" "$@"
fi

# 2. Auth subcommands pass through untouched
if [[ ${1:-} == "auth" ]]; then
	exec "${real_gh}" "$@"
fi

# 3. Non-default hosts pass through (only github.com is routed)
for arg in "$@"; do
	case "${arg}" in
	--hostname | --hostname=*)
		exec "${real_gh}" "$@"
		;;
	*) ;;
	esac
done

# Routing requires yq and a config.yaml; without them, pass through silently
CONFIG_YAML=""
if command -v yq >/dev/null 2>&1; then
	CONFIG_YAML="$(resolve_config)"
fi

gh_user=""
if [[ -n ${CONFIG_YAML} ]]; then
	# 4. Route by explicit owner in args
	owner="$(owner_from_args "$@")"
	if [[ -n ${owner} ]]; then
		gh_user="$(user_for_owner "${owner}")"
	fi

	# 5. Route by cwd
	if [[ -z ${gh_user} ]]; then
		gh_user="$(user_for_path "${PWD}")"
	fi
fi

# 6. No match → default behavior
if [[ -z ${gh_user} ]]; then
	exec "${real_gh}" "$@"
fi

# Inject a fresh keyring token for the resolved user into this process only
if ! token="$(env -u GH_TOKEN -u GITHUB_TOKEN "${real_gh}" auth token --user "${gh_user}" 2>/dev/null)"; then
	echo "gh wrapper: failed to get token for user '${gh_user}' (run 'gh auth status')" >&2
	exit 1
fi

GH_TOKEN="${token}" exec "${real_gh}" "$@"
