#!/bin/sh
# Wrapper: sfw -> real sfw (via mise), marking the environment so the
# npm/pnpm wrappers do not re-wrap when called from inside the firewall.
if [ -n "${SFW_ACTIVE}" ]; then
	# Already inside an sfw session: run the command directly, no extra proxy layer
	exec "$@"
fi
SFW_ACTIVE=1
export SFW_ACTIVE
exec mise x npm:sfw -- sfw "$@"
