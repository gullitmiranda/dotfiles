#!/usr/bin/env bash

# gh wrapper — routes GitHub CLI calls to the correct account by injecting a
# fresh keyring token for the resolved user.
#
# Routing precedence (first match wins):
#   1. GH_TOKEN/GITHUB_TOKEN already set → pass through (CI, mise, manual)
#   2. `gh auth ...` subcommands → pass through (keeps `gh auth status` truthful)
#   3. Non-github.com host (--hostname, GHE) → pass through
#   4. Explicit owner in args (-R owner/repo, --repo, GitHub URLs) → owners table
#   5. cwd inside a known gitdir → paths table
#   6. No match → pass through (active keyring account)
#
# Routing tables live in ~/.config/gh-router/config.json, generated by
# git-op-setup from config.yaml (accounts[].gh_user / owners / gitdirs).

set -euo pipefail

ROUTER_CONFIG="${GH_ROUTER_CONFIG:-${HOME}/.config/gh-router/config.json}"

### Resolve the real gh binary (avoid recursing into this wrapper)

resolve_real_gh() {
	local self candidate resolved dir
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
	if [[ -n ${GH_REAL_BIN:-} && -x ${GH_REAL_BIN} ]]; then
		echo "${GH_REAL_BIN}"
		return 0
	fi
	# Walk PATH entries in order, skip this wrapper
	local IFS=:
	for dir in ${PATH}; do
		candidate="${dir}/gh"
		if [[ -x ${candidate} ]]; then
			resolved="$(cd "${dir}" 2>/dev/null && pwd)/gh" || continue
			if [[ ${resolved} != "${self}" ]]; then
				echo "${candidate}"
				return 0
			fi
		fi
	done
	echo "gh wrapper: real gh binary not found in PATH" >&2
	exit 127
}

### Helpers

user_for_owner() {
	# Prints the gh_user mapped to the given owner, or empty string
	local owner="$1"
	[[ -f ${ROUTER_CONFIG} ]] || return 0
	# shellcheck disable=SC2016 # $o is a jq variable, not shell
	jq -r --arg o "${owner}" '.owners[$o] // empty' "${ROUTER_CONFIG}" 2>/dev/null || true
}

owner_from_args() {
	# Extract owner from -R/--repo flags or GitHub URLs in args
	local prev="" arg rest
	for arg in "$@"; do
		case "${prev}" in
		-R | --repo)
			echo "${arg%%/*}"
			return 0
			;;
		*) ;;
		esac
		case "${arg}" in
		-R*/*)
			echo "${arg#-R}" | cut -d/ -f1
			return 0
			;;
		--repo=*/*)
			echo "${arg#--repo=}" | cut -d/ -f1
			return 0
			;;
		*github.com/*)
			rest="${arg#*github.com/}"
			echo "${rest}" | cut -d/ -f1 | cut -d: -f2
			return 0
			;;
		*/*)
			# owner/repo positional arg (e.g. gh repo clone some-org/repo)
			echo "${arg}" | cut -d/ -f1
			return 0
			;;
		*) ;;
		esac
		prev="${arg}"
	done
	return 0
}

user_for_path() {
	# Longest-prefix match of cwd against the paths table
	local cwd="$1"
	[[ -f ${ROUTER_CONFIG} ]] || return 0
	jq -r --arg cwd "${cwd}" '
		.paths // {} | to_entries
		| map(select(.key as $k | ($cwd == $k or ($cwd | startswith($k + "/")))))
		| sort_by(.key | length) | last | .value? // empty
	' "${ROUTER_CONFIG}" 2>/dev/null || true
}

### Main

real_gh="$(resolve_real_gh)"

# 1. Respect an explicitly provided token
if [[ -n ${GH_TOKEN:-} || -n ${GITHUB_TOKEN:-} ]]; then
	exec "${real_gh}" "$@"
fi

# 2. Auth subcommands pass through untouched
if [[ ${1:-} == "auth" ]]; then
	exec "${real_gh}" "$@"
fi

# 3. Non-default hosts pass through (only github.com is routed)
for arg in "$@"; do
	case "${arg}" in
	--hostname | --hostname=*)
		exec "${real_gh}" "$@"
		;;
	*) ;;
	esac
done

# 4. Route by explicit owner in args
gh_user=""
owner="$(owner_from_args "$@")"
if [[ -n ${owner} ]]; then
	gh_user="$(user_for_owner "${owner}")"
fi

# 5. Route by cwd
if [[ -z ${gh_user} ]]; then
	gh_user="$(user_for_path "${PWD}")"
fi

# 6. No match → default behavior
if [[ -z ${gh_user} ]]; then
	exec "${real_gh}" "$@"
fi

# Inject a fresh keyring token for the resolved user into this process only
if ! token="$(env -u GH_TOKEN -u GITHUB_TOKEN "${real_gh}" auth token --user "${gh_user}" 2>/dev/null)"; then
	echo "gh wrapper: failed to get token for user '${gh_user}' (run 'gh auth status')" >&2
	exit 1
fi

GH_TOKEN="${token}" exec "${real_gh}" "$@"
