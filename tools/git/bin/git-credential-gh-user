#!/usr/bin/env bash

# Git credential helper that returns a GitHub token for an explicit gh account.
#
# Usage in gitconfig:
#   [credential "https://github.com"]
#     helper =
#     helper = !/absolute/path/git-credential-gh-user <github-user> [github-host]
#
# This intentionally ignores inherited GH_TOKEN/GITHUB_TOKEN values before
# asking `gh` for a token, making it suitable for GUI Git clients launched from
# an environment that may contain a token for a different account.

set -euo pipefail

gh_user="${1-}"
gh_host="${2:-github.com}"
command="${3-}"
gh_bin="${GH_USER_CREDENTIAL_GH_BIN:-/opt/homebrew/bin/gh}"

if [[ -z ${gh_user} ]]; then
	cat >&2 <<'EOF'
usage: git-credential-gh-user <github-user> [github-host] <command>

Example:
  git config --file ~/code/personal/.gitconfig \
    'credential.https://github.com.helper' \
    '!~/.local/bin/git-credential-gh-user your-github-username github.com'
EOF
	exit 1
fi

# Git may call helpers for store/erase. We do not persist or erase anything;
# tokens remain managed by gh/keyring.
if [[ ${command} != "get" ]]; then
	exit 0
fi

if [[ ! -x ${gh_bin} ]]; then
	if command -v gh >/dev/null 2>&1; then
		gh_bin="$(command -v gh)"
	else
		echo "git-credential-gh-user: gh CLI not found" >&2
		exit 1
	fi
fi

protocol=""
host=""

while IFS='=' read -r key value; do
	case "${key}" in
	protocol) protocol="${value}" ;;
	host) host="${value}" ;;
	*) ;;
	esac
done

# Only answer for HTTPS credentials for the configured host. Returning non-zero
# lets Git continue to the next configured helper, if any.
if [[ ${protocol} != "https" || ${host} != "${gh_host}" ]]; then
	exit 1
fi

# GH_TOKEN/GITHUB_TOKEN take precedence in gh. Unset them so --user selects the
# token stored for the intended account instead of an inherited environment token.
unset GH_TOKEN GITHUB_TOKEN

token="$(${gh_bin} auth token --hostname "${gh_host}" --user "${gh_user}")"

printf 'username=x-access-token\n'
printf 'password=%s\n' "${token}"
